# Database
DATABASE_URL="postgresql://aifocus:aifocus_secret_2024@localhost:5433/aifocus"

# Next.js
NEXTAUTH_URL="http://localhost:4444"
NEXTAUTH_SECRET="your-secret-key-here"

# App
NODE_ENV="development"

# Integrations
# Leave GITHUB_TOKEN empty to source it from the logged-in `gh` CLI at deploy
# time (scripts/up.sh) — required when tracked repos span multiple orgs.
GITHUB_TOKEN=""
# A PR or issue URL used to smoke-test GitHub badges after every deploy,
# e.g. a merged PR in one of your tracked repos.
GITHUB_SMOKE_URL=""
AZURE_DEVOPS=""
AZURE_DEVOPS_ORG=""

# Local AI
# For oMLX in local dev:
# AI_PROVIDER="omlx"
# AI_URL="http://localhost:11435/v1"
# AI_MODEL="gemma-4-26b-a4b-it-4bit"
AI_PROVIDER=""
AI_URL=""
AI_MODEL=""
AI_API_KEY=""
